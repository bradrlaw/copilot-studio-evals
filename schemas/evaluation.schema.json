{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/copilot-studio-evals/evaluation.schema.json",
  "title": "Copilot Studio canonical evaluation turn",
  "type": "object",
  "required": [
    "conversation_id",
    "turn_number",
    "user_message",
    "expected_tool_calls",
    "expected_response_pattern",
    "pass_criteria",
    "category"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_number": {
      "type": "integer",
      "minimum": 1
    },
    "user_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "params"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          },
          "via_agent": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "expected_response_pattern": {
      "type": [
        "string",
        "null"
      ]
    },
    "pass_criteria": {
      "enum": [
        "tool_called_correctly",
        "response_matches",
        "both"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "must_not_call": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "response_must_not_match": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluation_context": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
